.subckt hm_pg_lv_{{WIDTH}}x{{HEIGHT}} VPWR GPWR VGND CTRL
XM1 ctrl_n ctrl VGND VGND sg13_lv_nmos w={{invNmosW}}u l={{invNmosL}}u ng=1 m=1 mm_ok=1
XM2 ctrl_n ctrl VPWR VPWR sg13_lv_pmos w={{invPmosW}}u l={{invPmosL}}u ng=1 m=1 mm_ok=1
XM3 GPWR ctrl_n VPWR VPWR sg13_lv_pmos w={{width}}u l={{length}}u ng={{ng}} m={{m}} mm_ok=1
x1 VGND GPWR ctrl_n dischg
.ends

.subckt dischg VGND GPWR gate
